                    </button>
                    <button onclick="setTrajectoryMode('halflob')" id="btn-traj-halflob" class="traj-btn px-5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2 bg-slate-800 text-slate-300 hover:bg-slate-700">
                        <i class="fa-solid fa-chart-line"></i> 2. โยนครึ่งโด่ง (Demi-Portée)
                    </button>
                    <button onclick="setTrajectoryMode('highlob')" id="btn-traj-highlob" class="traj-btn px-5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2 bg-slate-800 text-slate-300 hover:bg-slate-700">
                        <i class="fa-solid fa-arrow-up-from-ground-water"></i> 3. โยนโด่งสูง (High Lob / Portée)
                    </button>
                    <button onclick="setTrajectoryMode('carreau')" id="btn-traj-carreau" class="traj-btn px-5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2 bg-slate-800 text-slate-300 hover:bg-slate-700">
                        <i class="fa-solid fa-burst"></i> 4. ตีติด / ตีเปลี่ยน (Carreau)
                    </button>
                </div>

