    <!-- JAVASCRIPT LOGIC -->
    <script>
        // MOBILE MENU DRAWER TOGGLE
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });
        document.querySelectorAll('.mobile-nav-link').forEach(link => {
            link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
        });

        // CANVAS TRAJECTORY SIMULATOR PHYSICS ENGINE
        const canvas = document.getElementById('trajectoryCanvas');
        const ctx = canvas.getContext('2d');

        let currentTrajMode = 'rolling';
        let animProgress = 0;
        let animId = null;

        const trajConfigs = {
            'rolling': {
                apexX: 0.25, apexY: 0.35, landX: 0.45, finalX: 0.88,
                title: 'การเข้าเรียบ (Rolling Pointing)',
                text: 'ปล่อยลูกให้ลอยต่ำ ตกกระทบพื้นดินห่างจากแก่นประมาณ 2/3 ของระยะทาง แล้วให้ลูกวิ่งกลิ้งเข้าใกล้เป้าหมาย เหมาะสำหรับสนามดินบดแน่นราบเรียบ',
                apexText: '0.4m', landingText: '2.5m', spinText: 'Low Spin'
            },
            'halflob': {
                apexX: 0.35, apexY: 0.65, landX: 0.68, finalX: 0.88,
                title: 'โยนครึ่งโด่ง (Demi-Portée)',
                text: 'โยนลูกลอยสูงระดับปานกลาง ให้ลูกตกประมาณครึ่งทาง แล้วกลิ้งต่อเข้าหาแก่น ป้องกันการแฉลบหินขวางทาง',
                apexText: '1.5m', landingText: '4.8m', spinText: 'Medium Backspin'
            },
            'highlob': {
                apexX: 0.45, apexY: 0.90, landX: 0.82, finalX: 0.86,
                title: 'โยนโด่งสูง (High Lob / Portée)',
                text: 'โยนลูกลอยสูงมากกลางอากาศ ให้ลูกตกดิ่งใกล้มุมแก่น พร้อมแรงหมุน Backspin รุนแรง ทำให้ลูกหยุดนิ่งทันทีหลังตกกระทบ',
                apexText: '3.2m', landingText: '7.2m', spinText: 'High Backspin'
            },
            'carreau': {
                apexX: 0.45, apexY: 0.55, landX: 0.88, finalX: 0.88,
                title: 'ตีติด / ตีเปลี่ยน (Carreau Shooting)',
                text: 'ยิงลูกพุ่งตรงเข้าชนกลางลูกเป้าหมายอย่างเต็มแรง ลูกเป้าหมายกระเด็นออก ส่วนลูกยิงหยุดหยุดนิ่งแทนนิ่ง ณ ตำแหน่งเดิม',
                apexText: '1.2m', landingText: '8.0m (Direct Hit)', spinText: 'Max Backspin'
            }
        };

        function resizeCanvas() {
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;
            drawTrajectory();
        }

        window.addEventListener('resize', resizeCanvas);

        function setTrajectoryMode(mode) {
            currentTrajMode = mode;
            document.querySelectorAll('.traj-btn').forEach(btn => {
                btn.className = 'traj-btn px-5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2 bg-slate-800 text-slate-300 hover:bg-slate-700';
            });
            document.getElementById(`btn-traj-${mode}`).className = 'traj-btn px-5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2 bg-terracotta-600 text-white shadow-glow-orange';

            const cfg = trajConfigs[mode];
            document.getElementById('sim-title').innerText = cfg.title;
            document.getElementById('sim-text').innerText = cfg.text;
            document.getElementById('sim-apex').innerText = cfg.apexText;
            document.getElementById('sim-landing').innerText = cfg.landingText;
            document.getElementById('sim-spin').innerText = cfg.spinText;

            runTrajectoryAnim();
        }

        function runTrajectoryAnim() {
            animProgress = 0;
            if (animId) cancelAnimationFrame(animId);
            animateCanvas();
        }

        function animateCanvas() {
            animProgress += 0.02;
            drawTrajectory();
            if (animProgress < 1) {
                animId = requestAnimationFrame(animateCanvas);
            }
        }

        function drawTrajectory() {
            if (!canvas.width) return;
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            const cfg = trajConfigs[currentTrajMode];
            const startX = canvas.width * 0.08;
            const startY = canvas.height * 0.82;
            const groundY = canvas.height * 0.82;

            // Draw Ground Surface
            ctx.beginPath();
            ctx.moveTo(0, groundY);
            ctx.lineTo(canvas.width, groundY);
            ctx.strokeStyle = '#334155';
            ctx.lineWidth = 3;
            ctx.stroke();

            // Ground fill
            ctx.fillStyle = '#0f172a';
            ctx.fillRect(0, groundY, canvas.width, canvas.height - groundY);

            // Target Jack (Cochonnet)
            const jackX = canvas.width * 0.88;
            ctx.beginPath();
            ctx.arc(jackX, groundY - 6, 6, 0, Math.PI * 2);
            ctx.fillStyle = '#fbbf24';
            ctx.fill();

            // Calculate Curve Points
            const apexX = canvas.width * cfg.apexX;
            const apexY = groundY - (canvas.height * 0.65 * cfg.apexY);
            const landX = canvas.width * cfg.landX;
            const finalX = canvas.width * cfg.finalX;

            // Dotted Full Trajectory Line
            ctx.beginPath();
            ctx.moveTo(startX, startY);
            ctx.quadraticCurveTo(apexX, apexY, landX, groundY);
            ctx.lineTo(finalX, groundY);
            ctx.setLineDash([4, 4]);
            ctx.strokeStyle = 'rgba(224, 83, 38, 0.4)';
            ctx.lineWidth = 2;
            ctx.stroke();
            ctx.setLineDash([]);

            // Animated Moving Ball along Path
            let ballX, ballY;
            if (animProgress <= 0.7) {
                const t = animProgress / 0.7;
                ballX = (1 - t) * (1 - t) * startX + 2 * (1 - t) * t * apexX + t * t * landX;
                ballY = (1 - t) * (1 - t) * startY + 2 * (1 - t) * t * apexY + t * t * groundY;
            } else {
                const t = (animProgress - 0.7) / 0.3;
                ballX = landX + (finalX - landX) * t;
                ballY = groundY;
            }

            // Draw Petanque Ball
            ctx.beginPath();
            ctx.arc(ballX, ballY - 10, 10, 0, Math.PI * 2);
            ctx.fillStyle = '#e2e8f0';
            ctx.fill();
            ctx.strokeStyle = '#cb3a11';
            ctx.lineWidth = 2;
            ctx.stroke();
        }

        // Initialize Canvas on Load
        setTimeout(() => {
            resizeCanvas();
            setTrajectoryMode('rolling');
        }, 100);

        // PETANQUE CALCULATOR LOGIC
        let selectedPos = 'pointer';

        function setCalcPosition(pos) {
            selectedPos = pos;
            document.querySelectorAll('.calc-pos-btn').forEach(btn => {
                btn.className = 'calc-pos-btn p-3 rounded-2xl border text-center transition bg-slate-900 border-slate-800 text-slate-400 hover:text-slate-200';
            });
            document.getElementById(`btn-pos-${pos}`).className = 'calc-pos-btn p-3 rounded-2xl border text-center transition bg-terracotta-600/20 border-terracotta-500 text-white';
            updateCalculator();
        }

        function updateCalculator() {
            const handLen = parseInt(document.getElementById('hand-slider').value);
            document.getElementById('hand-length-val').innerText = `${handLen} mm`;

            let dia = 72;
            let weight = 690;
            let hardness = 'ปานกลาง (Half-soft)';
            let hardnessVal = '120 kg/mm²';
            let material = 'สแตนเลส (Stainless Steel)';
            let advice = '';

            if (handLen < 165) dia = 71;
            else if (handLen <= 175) dia = 72;
            else if (handLen <= 185) dia = 73;
            else if (handLen <= 195) dia = 74;
            else dia = 75;

            if (selectedPos === 'pointer') {
                weight = 700;
                hardness = 'แข็ง (Hard)';
                hardnessVal = '140 kg/mm²';
                material = 'สแตนเลส หรือ เหล็กคาร์บอนลายเดี่ยว';
                advice = 'เน้นลูกขนาดกระชับมือ น้ำหนักแน่นเพื่อยึดตำแหน่งหน้าแก่นไม่หลุดแฉลบ';
            } else if (selectedPos === 'shooter') {
                dia = Math.min(80, dia + 1);
                weight = 680;
                hardness = 'นิ่มมาก (Very Soft)';
                hardnessVal = '110 kg/mm²';
                material = 'เหล็กคาร์บอน (Carbon Steel) ลูกเรียบไร้ลาย';
                advice = 'ลูกนิ่มช่วยซับแรงกระแทก ตีติด (Carreau) ได้ดีเยี่ยม และลดอาการเมื่อยแขน';
            } else {
                weight = 690;
                hardness = 'นิ่ม (Soft)';
                hardnessVal = '115 kg/mm²';
                material = 'สแตนเลส สเปกสมดุล';
                advice = 'สมดุลทั้งการเข้าลูกและการยิง เหมาะสำหรับตำแหน่งเล่นรอบด้าน';
            }

            document.getElementById('res-diameter').innerText = `${dia} มม.`;
            document.getElementById('res-dia-range').innerText = `${dia - 1}-${dia + 1}`;
            document.getElementById('res-weight').innerText = `${weight} กรัม`;
            document.getElementById('res-weight-range').innerText = `${weight - 10}-${weight + 10}`;
            document.getElementById('res-hardness').innerText = hardness;
            document.getElementById('res-hardness-val').innerText = hardnessVal;
            document.getElementById('res-material').innerText = material;
            document.getElementById('res-advice').innerText = advice;

            const percent = Math.min(100, Math.max(20, Math.round(((handLen - 150) / 70) * 100)));
            document.getElementById('fit-percent').innerText = `${percent}%`;
            document.getElementById('fit-gauge-bar').style.width = `${percent}%`;
        }

        updateCalculator();

        // FILTER & SEARCH TECHNIQUES
        function filterTechniques(level) {
            const cards = document.querySelectorAll('.tech-card');
            const btns = document.querySelectorAll('.tech-filter-btn');

            btns.forEach(btn => {
                if (btn.getAttribute('data-filter') === level) {
                    btn.className = 'tech-filter-btn px-4 py-2 text-xs font-bold rounded-xl border transition bg-terracotta-600 text-white border-terracotta-500';
                } else {
                    btn.className = 'tech-filter-btn px-4 py-2 text-xs font-bold rounded-xl border transition bg-slate-800 text-slate-300 border-slate-700 hover:bg-slate-700';
                }
            });

            cards.forEach(card => {
                if (level === 'all' || card.getAttribute('data-level') === level) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });
        }

        function searchTechniques() {
            const query = document.getElementById('tech-search').value.toLowerCase();
            document.querySelectorAll('.tech-card').forEach(card => {
                const text = card.innerText.toLowerCase();
                if (text.includes(query)) card.classList.remove('hidden');
                else card.classList.add('hidden');
            });
        }

        // MODAL DATA & FUNCTIONS
        const modalData = {
            'grip-modal': {
                title: 'การจับลูกเปตอง (Grip Mechanics)',
                content: `
                    <div class="space-y-4 text-xs sm:text-sm text-slate-300">
                        <p>หัวใจสำคัญของการควบคุมทิศทางลูกคือการไม่ใช้ฝ่ามือโอบกำแน่น แต่ให้แขวนลูกด้วยปลายนิ้ว</p>
                        <ul class="list-disc list-inside space-y-1 text-slate-300">
                            <li>วางลูกบนรอยพับข้อนิ้วทั้ง 4 (นิ้วชี้ ถึง นิ้วก้อย ชิดกัน)</li>
                            <li>นิ้วหัวแม่มือประคองข้างหลวมๆ ห้ามใช้กดลูก</li>
                            <li>ขณะปล่อยลูก สะบัดข้อมือขึ้นเบาๆ ให้ลูกผ่านปลายนิ้วสร้าง Backspin</li>
                        </ul>
                    </div>
                `
            },
            'stance-modal': {
                title: 'การยืนและทรงตัวในวงกลม (Stance)',
                content: `
                    <div class="space-y-4 text-xs sm:text-sm text-slate-300">
                        <p>เท้าทั้งสองต้องวางราบอยู่ภายในวงกลมขนาด 35-50 ซม. ห้ามยกเท้าหรือเหยียบขอบวงกลมก่อนลูกตกพื้น</p>
                        <p>ย่อเข่าเล็กน้อยสร้างศูนย์ถ่วง ลำตัวนิ่ง สายตาเพ่งที่จุดตกเป้าหมาย (Donnée)</p>
                    </div>
                `
            },
            'rolling-modal': {
                title: 'การเข้าเรียบ (Rolling Pointing)',
                content: `
                    <div class="space-y-4 text-xs sm:text-sm text-slate-300">
                        <p>ปล่อยลูกให้ลอยต่ำ ตกกระทบพื้นดินห่างจากเป้าหมาย แล้วให้ลูกวิ่งกลิ้งเข้าหาแก่น เหมาะกับสนามดินบดแน่นราบเรียบ</p>
                    </div>
                `
            },
            'highlob-modal': {
                title: 'การโยนโด่งข้ามอุปสรรค (High Lob)',
                content: `
                    <div class="space-y-4 text-xs sm:text-sm text-slate-300">
                        <p>เหวี่ยงแขนสูงขึ้นฟ้า ปล่อยลูกมุมดิ่ง พร้อมสะบัดข้อมือถอยหลัง (Backspin) รุนแรง เพื่อหยุดวิถีลูกทันทีหลังตกกระทบพื้น</p>
                    </div>
                `
            },
            'carreau-modal': {
                title: 'ตีติด / ตีเปลี่ยน (Tir au Carreau)',
                content: `
                    <div class="space-y-4 text-xs sm:text-sm text-slate-300">
                        <p>ยิงลูกพุ่งตรงเข้าชนกลางลูกเป้าหมายอย่างเต็มแรง ลูกเป้าหมายกระเด็นออก ส่วนลูกยิงหยุดหยุดนิ่งแทนนิ่ง ณ ตำแหน่งเดิม</p>
                    </div>
                `
            },
            'directhit-modal': {
                title: 'การตีโดนตรง (Direct Hit Shooting)',
                content: `
                    <div class="space-y-4 text-xs sm:text-sm text-slate-300">
                        <p>การยิงลูกเป้าหมายในอากาศโดยไม่ตกกระทบพื้นก่อน เพื่อเคลียร์ลูกคู่แข่งออกจากพื้นที่อย่างเด็ดขาด</p>
                    </div>
                `
            }
        };

        function openModal(key) {
            const data = modalData[key];
            if (data) {
                document.getElementById('modal-body').innerHTML = `
                    <h3 class="text-lg font-bold text-white mb-4 pb-2 border-b border-slate-800">${data.title}</h3>
                    ${data.content}
                `;
                document.getElementById('modal-backdrop').classList.remove('hidden');
            }
        }

        function closeModal() {
            document.getElementById('modal-backdrop').classList.add('hidden');
        }

        document.getElementById('modal-backdrop').addEventListener('click', (e) => {
            if (e.target.id === 'modal-backdrop') closeModal();
        });
    </script>
</body>
</html>