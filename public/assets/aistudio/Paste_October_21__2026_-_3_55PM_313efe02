                        </div>
                    </div>

                    <button onclick="runTrajectoryAnim()" class="absolute bottom-4 right-4 px-4 py-2 bg-terracotta-600 hover:bg-terracotta-500 text-white font-bold text-xs rounded-xl shadow-lg flex items-center gap-2 transition">
